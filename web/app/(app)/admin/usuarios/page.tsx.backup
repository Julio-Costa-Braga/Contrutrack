// web/app/(app)/admin/usuarios/page.tsx
'use client'
import { useState, useEffect } from 'react'
import { createClient } from '@/lib/supabase/client'
import toast from 'react-hot-toast'
import { Plus, Trash2, Check, UserX, UserCheck, Key, Settings, Edit2, ChevronDown } from 'lucide-react'

const MODULOS = [
  { key: 'dashboard', label: 'Dashboard' },
  { key: 'obras', label: 'Estaleiros' },
  { key: 'ponto', label: 'Ponto Eletrónico', fixed: true },
  { key: 'rh', label: 'RH & Onboarding' },
  { key: 'compras', label: 'Compras' },
  { key: 'relatorios', label: 'Relatórios ACT' },
  { key: 'financeiro', label: 'Financeiro' },
  { key: 'aprovacoes', label: 'Aprovações' },
  { key: 'cotacoes', label: 'Cotações' },
  { key: 'integracoes', label: 'Integrações' },
  { key: 'acessos', label: 'Acessos' },
  { key: 'alertas', label: 'Alertas' },
  { key: 'admin', label: 'Administração', adminOnly: true },
]

const TIPOS_ALERTAS = [
  { key: 'ponto_atraso', label: 'Atraso no Ponto' },
  { key: 'ponto_saida', label: 'Saída sem registo' },
  { key: 'requisicao_pendente', label: 'Requisição pendente' },
  { key: 'obra_orcamento', label: 'Orçamento de obra excedido' },
  { key: 'obra_estado', label: 'Mudança de estado de obra' },
  { key: 'funcionario_ferias', label: 'Férias de funcionário' },
  { key: 'documento_vencimento', label: 'Documento a vencer' },
]

const SETORES_DEFAULT = [
  { id: 'administracao', nome: 'Administração' },
  { id: 'recursos_humanos', nome: 'Recursos Humanos' },
  { id: 'financeiro', nome: 'Financeiro' },
  { id: 'engenharia', nome: 'Engenharia' },
  { id: 'obras', nome: 'Obras' },
  { id: 'compras', nome: 'Compras' },
  { id: 'seguranca', nome: 'Segurança do Trabalho' },
  { id: 'ti', nome: 'Tecnologia da Informação' },
]

const FUNCOES_DEFAULT = [
  { id: 'estagiario', nome: 'Estagiário', acessos: ['ponto'] },
  { id: 'auxiliar', nome: 'Auxiliar', acessos: ['ponto'] },
  { id: 'assistente', nome: 'Assistente', acessos: ['ponto'] },
  { id: 'analista', nome: 'Analista', acessos: ['ponto'] },
  { id: 'analista_jr', nome: 'Analista Jr', acessos: ['ponto'] },
  { id: 'analista_pl', nome: 'Analista Pl', acessos: ['ponto', 'compras'] },
  { id: 'analista_sr', nome: 'Analista Sr', acessos: ['ponto', 'compras', 'financeiro'] },
  { id: 'tecnico', nome: 'Técnico', acessos: ['ponto', 'obras'] },
  { id: 'supervisor', nome: 'Supervisor', acessos: ['obras', 'ponto', 'rh'] },
  { id: 'coordenador', nome: 'Coordenador', acessos: ['obras', 'ponto', 'rh'] },
  { id: 'gerente', nome: 'Gerente', acessos: ['obras', 'ponto', 'rh', 'compras', 'financeiro'] },
  { id: 'diretor', nome: 'Diretor', acessos: MODULOS.filter(m => !m.adminOnly && m.key !== 'dashboard' && m.key !== 'acessos' && m.key !== 'alertas').map(m => m.key) },
  { id: 'administrador', nome: 'Administrador', acessos: MODULOS.filter(m => m.key !== 'admin').map(m => m.key) },
]

interface Setor {
  id: string
  nome: string
}

interface Funcao {
  id: string
  nome: string
  acessos: string[]
}

export default function AdminUsuariosPage() {
  const supabase = createClient()
  const [usuarios, setUsuarios] = useState<any[]>([])
  const [setores, setSetores] = useState<Setor[]>(SETORES_DEFAULT)
  const [funcoes, setFuncoes] = useState<Funcao[]>(FUNCOES_DEFAULT)
  const [loading, setLoading] = useState(true)
  
  const [showModal, setShowModal] = useState(false)
  const [showSenhaModal, setShowSenhaModal] = useState(false)
  const [showSetorModal, setShowSetorModal] = useState(false)
  const [showFuncaoModal, setShowFuncaoModal] = useState(false)
  const [showEditPerfilModal, setShowEditPerfilModal] = useState(false)
  const [showAcessosModal, setShowAcessosModal] = useState(false)
  const [editPerfilForm, setEditPerfilForm] = useState({ nome: '', setor: '', funcao: '', acessos: ['ponto'] as string[], alertas: ['ponto_atraso', 'ponto_saida', 'requisicao_pendente', 'obra_orcamento'] as string[] })
  
  const [selectedUser, setSelectedUser] = useState<any>(null)
  const [novaSenha, setNovaSenha] = useState('')
  
  const [novoSetorNome, setNovoSetorNome] = useState('')
  const [novoFuncaoNome, setNovoFuncaoNome] = useState('')
  const [novoFuncaoAcessos, setNovoFuncaoAcessos] = useState<string[]>(['ponto'])
  const [editandoFuncao, setEditandoFuncao] = useState<Funcao | null>(null)
  
  const [form, setForm] = useState({ 
    email: '', senha: '', nome: '', 
    setor: 'obras', funcao: 'auxiliar',
    acessos: ['ponto'] as string[]
  })

  useEffect(() => { loadData() }, [])

  // Verificar se deve abrir modal de edição via URL
  useEffect(() => {
    if (typeof window !== 'undefined') {
      const params = new URLSearchParams(window.location.search)
      const editId = params.get('edit')
      if (editId && usuarios.length > 0) {
        const user = usuarios.find(u => u.id === editId)
        if (user) {
          handleEditarPerfil(user)
          // Limpar URL
          window.history.replaceState({}, '', '/admin/usuarios')
        }
      }
    }
  }, [usuarios])

  async function loadData() {
    setLoading(true)
    try {
      const { data: perfisData } = await supabase
        .from('perfis')
        .select('*, acessos, alertas_pref')
        .order('created_at', { ascending: false })
      setUsuarios(perfisData || [])
    } catch (e) {
      console.log('Erro a carregar perfis:', e)
    }
    setSetores(SETORES_DEFAULT)
    setFuncoes(FUNCOES_DEFAULT)
    setLoading(false)
  }

  function toggleAcesso(key: string) {
    if (key === 'ponto') return
    setForm(prev => ({
      ...prev,
      acessos: prev.acessos.includes(key) ? prev.acessos.filter(a => a !== key) : [...prev.acessos, key]
    }))
  }

  function toggleNovoFuncaoAcesso(key: string) {
    if (key === 'ponto') return
    setNovoFuncaoAcessos(prev => 
      prev.includes(key) ? prev.filter(a => a !== key) : [...prev, key]
    )
  }

  function toggleEditPerfilAcesso(key: string) {
    if (key === 'ponto') return
    if (key === 'admin') {
      const todosModulos = MODULOS.filter(m => !m.adminOnly && m.key !== 'ponto' && m.key !== 'acessos' && m.key !== 'alertas').map(m => m.key)
      const todosSelecionados = todosModulos.every(m => editPerfilForm.acessos.includes(m))
      if (todosSelecionados) {
        setEditPerfilForm(prev => ({ ...prev, acessos: ['ponto'] }))
      } else {
        setEditPerfilForm(prev => ({ ...prev, acessos: ['ponto', ...todosModulos] }))
      }
      return
    }
    setEditPerfilForm(prev => ({
      ...prev,
      acessos: prev.acessos.includes(key) ? prev.acessos.filter(a => a !== key) : [...prev.acessos, key]
    }))
  }

  function toggleEditPerfilAlerta(key: string) {
    setEditPerfilForm(prev => ({
      ...prev,
      alertas: prev.alertas.includes(key) ? prev.alertas.filter(a => a !== key) : [...prev.alertas, key]
    }))
  }

  function handleFuncaoChange(funcaoId: string) {
    const funcaoInfo = funcoes.find(f => f.id === funcaoId)
    const acessos = funcaoInfo?.acessos || ['ponto']
    const filtered = [...acessos]
    if (!filtered.includes('ponto')) filtered.push('ponto')
    setForm(prev => ({ ...prev, funcao: funcaoId, acessos: filtered }))
  }

  async function handleCriarSetor(e: React.FormEvent) {
    e.preventDefault()
    if (!novoSetorNome.trim()) { toast.error('Nome do setor é obrigatório'); return }
    const id = novoSetorNome.toLowerCase().replace(/\s+/g, '_')
    const { error } = await (supabase as any).from('setores').insert({ id, nome: novoSetorNome })
    if (error) toast.error(error.message)
    else { toast.success('Setor criado!'); setNovoSetorNome(''); setShowSetorModal(false); loadData() }
  }

  function handleEditFuncao(funcao: any) {
    setEditandoFuncao(funcao)
    setNovoFuncaoNome(funcao.nome)
    setNovoFuncaoAcessos(funcao.acessos)
    setShowFuncaoModal(true)
  }

  async function handleCriarFuncao(e: React.FormEvent) {
    e.preventDefault()
    if (!novoFuncaoNome.trim()) { toast.error('Nome da função é obrigatório'); return }
    const id = novoFuncaoNome.toLowerCase().replace(/\s+/g, '_')
    let acessos = novoFuncaoAcessos.filter(a => a !== 'dashboard')
    if (!acessos.includes('ponto')) acessos.push('ponto')
    
    if (editandoFuncao) {
      const { error } = await (supabase as any).from('funcoes').update({ nome: novoFuncaoNome, acessos }).eq('id', editandoFuncao.id)
      if (error) toast.error(error.message)
      else toast.success('Função atualizada!')
    } else {
      const { error } = await (supabase as any).from('funcoes').insert({ id, nome: novoFuncaoNome, acessos })
      if (error) toast.error(error.message)
      else toast.success('Função criada!')
    }
    setShowFuncaoModal(false)
    setNovoFuncaoNome('')
    setNovoFuncaoAcessos(['ponto'])
    setEditandoFuncao(null)
    loadData()
  }

  async function handleDeleteFuncao(funcao: Funcao) {
    if (!confirm(`Eliminar a função "${funcao.nome}"?`)) return
    await (supabase as any).from('funcoes').delete().eq('id', funcao.id)
    toast.success('Função eliminada')
    loadData()
  }

  async function handleCreate(e: React.FormEvent) {
    e.preventDefault()
    const payload = {
      action: 'inviteUser',
      email: form.email,
      nome: form.nome,
      setor: form.setor,
      funcao: form.funcao
    }
    const res = await fetch('/api/admin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    const data = await res.json()
    if (data.error) { 
      toast.error(data.error)
      return 
    }
    const inviteUrl = `${window.location.origin}/convite?token=${data.token}`
    await navigator.clipboard.writeText(inviteUrl)
    toast.success('Convite criado! Link copiado para área de transferência')
    setShowModal(false)
    setForm({ email: '', senha: '', nome: '', setor: 'obras', funcao: 'auxiliar', acessos: ['ponto'] })
    loadData()
  }

  async function handleToggleAtivo(user: any) {
    await (supabase as any).from('perfis').update({ ativo: !user.ativo }).eq('id', user.id)
    toast.success(user.ativo ? 'Bloqueado' : 'Desbloqueado')
    loadData()
  }

  async function handleDelete(user: any) {
    if (!confirm(`Eliminar "${user.nome_completo}"?`)) return
    const res = await fetch('/api/admin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'deleteUser', userId: user.id })
    })
    const data = await res.json()
    if (data.error) {
      toast.error(data.error)
    } else {
      toast.success('Eliminado')
      loadData()
    }
  }

  function handleEditarPerfil(user: any) {
    setSelectedUser(user)
    const acessos = Array.isArray(user.acessos) ? [...user.acessos] : ['ponto']
    const alertas = Array.isArray(user.alertas_pref) ? [...user.alertas_pref] : ['ponto_atraso', 'ponto_saida', 'requisicao_pendente', 'obra_orcamento']
    setEditPerfilForm({
      nome: user.nome_completo || '',
      setor: user.setor || '',
      funcao: user.papel || '',
      acessos,
      alertas
    })
    setShowEditPerfilModal(true)
  }

  function handleLiberarAcessos(user: any) {
    setSelectedUser(user)
    const acessos = Array.isArray(user.acessos) ? [...user.acessos] : ['ponto']
    const alertas = Array.isArray(user.alertas_pref) ? [...user.alertas_pref] : ['ponto_atraso', 'ponto_saida', 'requisicao_pendente', 'obra_orcamento']
    setEditPerfilForm({
      nome: user.nome_completo || '',
      setor: user.setor || '',
      funcao: user.papel || '',
      acessos,
      alertas
    })
    setShowAcessosModal(true)
  }

  async function handleSavePerfil() {
    if (!selectedUser) return
    try {
      const res = await fetch('/api/admin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'updatePerfil',
          userId: selectedUser.id,
          nome_completo: editPerfilForm.nome,
          setor: editPerfilForm.setor,
          funcao: editPerfilForm.funcao,
          acessos: editPerfilForm.acessos,
          alertas_pref: editPerfilForm.alertas
        })
      })
      const data = await res.json()
      if (data.error) {
        toast.error(data.error + (data.details ? ` (${data.details})` : ''))
      } else {
        toast.success('Perfil atualizado!')
        setShowEditPerfilModal(false)
        loadData()
      }
    } catch (e: any) {
      toast.error(e.message || 'Erro ao guardar')
    }
  }

  async function handleSaveAcessos() {
    if (!selectedUser) return
    try {
      const res = await fetch('/api/admin', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'updatePerfil',
          userId: selectedUser.id,
          acessos: editPerfilForm.acessos,
          alertas_pref: editPerfilForm.alertas
        })
      })
      const data = await res.json()
      if (data.error) {
        toast.error(data.error + (data.details ? ` (${data.details})` : ''))
      } else {
        toast.success('Acessos atualizados!')
        setShowAcessosModal(false)
        loadData()
      }
    } catch (e: any) {
      toast.error(e.message || 'Erro ao guardar')
    }
  }

  async function handleResetSenha() {
    if (!novaSenha || novaSenha.length < 6) { toast.error('Mínimo 6 caracteres'); return }
    const res = await fetch('/api/admin', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'updatePassword',
        userId: selectedUser.id,
        password: novaSenha
      })
       })
    const data = await res.json()
    if (data.error) toast.error(data.error)
    else { toast.success('Senha alterada!'); setShowSenhaModal(false); setNovaSenha('') }
  }

  if (loading) return <div className="p-8">A carregar...</div>
  
  return (
    <div className="p-6">
      <div className="flex items-center justify-between mb-6">
        <div>
          <h1 className="text-xl font-semibold">Gestão de Equipa</h1>
          <p className="text-sm text-gray-500 mt-0.5">Gerencie setores, funções e acessos dos colaboradores</p>
        </div>
        <div className="flex gap-2">
          <button onClick={() => setShowSetorModal(true)} className="btn"><Settings className="w-4 h-4" /> Setores</button>
          <button onClick={() => setShowFuncaoModal(true)} className="btn"><Settings className="w-4 h-4" /> Funções</button>
          <button onClick={() => setShowModal(true)} className="btn btn-primary"><Plus className="w-4 h-4" /> Novo Colaborador</button>
        </div>
      </div>

      {/* Setores e Funções */}
      <div className="grid grid-cols-2 gap-4 mb-6">
        <div className="card">
          <h3 className="font-medium mb-3">Setores</h3>
          <div className="flex flex-wrap gap-2">
            {setores.map(s => (
              <span key={s.id} className="px-3 py-1.5 bg-blue-50 text-blue-700 rounded-full text-sm">{s.nome}</span>
            ))}
          </div>
        </div>
        <div className="card">
          <h3 className="font-medium mb-3">Funções</h3>
          <div className="flex flex-wrap gap-2">
            {funcoes.map(f => (
              <span key={f.id} className="inline-flex items-center gap-1 px-3 py-1.5 bg-gray-100 rounded-full text-sm">
                {f.nome}
                {!FUNCOES_DEFAULT.find(d => d.id === f.id) && (
                  <button onClick={() => handleEditFuncao(f)} className="hover:text-blue-600"><Edit2 className="w-3 h-3" /></button>
                )}
              </span>
            ))}
          </div>
        </div>
      </div>

      {/* Tabela Utilizadores */}
      <div className="card overflow-hidden overflow-x-auto">
        <table className="w-full text-sm min-w-[700px]">
          <thead>
            <tr className="border-b border-gray-200 bg-gray-50">
              <th className="text-left py-3 px-4 text-gray-500 font-medium">Colaborador</th>
              <th className="text-left py-3 px-4 text-gray-500 font-medium">Setor</th>
              <th className="text-left py-3 px-4 text-gray-500 font-medium">Função</th>
              <th className="text-left py-3 px-4 text-gray-500 font-medium">Acessos</th>
              <th className="text-left py-3 px-4 text-gray-500 font-medium">Alertas</th>
              <th className="text-left py-3 px-4 text-gray-500 font-medium">Estado</th>
              <th className="text-right py-3 px-4 text-gray-500 font-medium">Ações</th>
            </tr>
          </thead>
          <tbody>
            {usuarios.map(u => {
              const setorInfo = setores.find(s => s.id === u.setor)
              const funcaoInfo = funcoes.find(f => f.id === u.papel)
              return (
                <tr key={u.id} className="border-b border-gray-100 hover:bg-gray-50">
                  <td className="py-3 px-4">
                    <div className="font-medium">{u.nome_completo}</div>
                    <div className="text-xs text-gray-400">{u.email}</div>
                  </td>
                  <td className="py-3 px-4"><span className="pill pill-blue">{setorInfo?.nome || u.setor || '-'}</span></td>
                  <td className="py-3 px-4"><span className="pill pill-green">{funcaoInfo?.nome || u.papel}</span></td>
                  <td className="py-3 px-4">
                    <div className="flex flex-wrap gap-1">
                      {(u.acessos || ['ponto']).map((a: string) => {
                        const mod = MODULOS.find(m => m.key === a)
                        return mod ? <span key={a} className="text-xs px-1.5 py-0.5 bg-slate-100 text-slate-700 rounded">{mod.label}</span> : null
                      })}
                    </div>
                  </td>
                  <td className="py-3 px-4">
                    <div className="flex flex-wrap gap-1">
                      {(u.alertas_pref || []).map((a: string) => {
                        const alerta = TIPOS_ALERTAS.find(t => t.key === a)
                        return alerta ? <span key={a} className="text-xs px-1.5 py-0.5 bg-amber-50 text-amber-700 rounded">{alerta.label}</span> : null
                      })}
                    </div>
                  </td>
                  <td className="py-3 px-4">
                    <button onClick={() => handleToggleAtivo(u)} className={`text-xs px-2 py-1 rounded-full flex items-center gap-1 ${u.ativo ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
                      {u.ativo ? <><Check className="w-3 h-3" /> Ativo</> : <><UserX className="w-3 h-3" /> Inativo</>}
                    </button>
                  </td>
                  <td className="py-3 px-4 text-right">
                    <div className="flex items-center justify-end gap-1">
                      <button onClick={() => handleLiberarAcessos(u)} className="p-1.5 text-blue-500 hover:text-blue-700 hover:bg-blue-50 rounded" title="Liberar Acessos">
                        <Settings className="w-4 h-4" />
                      </button>
                      <button onClick={() => handleEditarPerfil(u)} className="p-1.5 text-gray-500 hover:text-slate-700 hover:bg-gray-100 rounded" title="Editar"><Edit2 className="w-4 h-4" /></button>
                      <button onClick={() => { setSelectedUser(u); setShowSenhaModal(true) }} className="p-1.5 text-gray-500 hover:text-slate-700 hover:bg-gray-100 rounded"><Key className="w-4 h-4" /></button>
                      <button onClick={() => handleToggleAtivo(u)} className={`p-1.5 rounded ${u.ativo ? 'text-red-500 hover:bg-red-50' : 'text-green-500 hover:bg-green-50'}`}>
                        {u.ativo ? <UserX className="w-4 h-4" /> : <UserCheck className="w-4 h-4" />}
                      </button>
                      <button onClick={() => handleDelete(u)} className="p-1.5 text-red-600 hover:bg-red-50 rounded"><Trash2 className="w-4 h-4" /></button>
                    </div>
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>

      {/* Modal Novo Colaborador */}
      {showModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <h2 className="text-lg font-semibold mb-4">Novo Colaborador</h2>
            <form onSubmit={handleCreate} className="space-y-4">
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="label">Nome completo *</label>
                  <input required className="input" value={form.nome} onChange={e => setForm({ ...form, nome: e.target.value })} placeholder="João Silva" />
                </div>
                <div>
                  <label className="label">Email *</label>
                  <input type="email" required className="input" value={form.email} onChange={e => setForm({ ...form, email: e.target.value })} placeholder="joao@empresa.pt" />
                </div>
              </div>
              <div className="bg-blue-50 border border-blue-200 rounded-lg p-3 text-sm text-blue-700">
                O colaborador receberá um email de convite para criar sua própria senha.
              </div>
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="label">Setor</label>
                  <select className="input" value={form.setor} onChange={e => setForm({ ...form, setor: e.target.value })}>
                    {setores.map(s => <option key={s.id} value={s.id}>{s.nome}</option>)}
                  </select>
                </div>
                <div>
                  <label className="label">Função</label>
                  <select className="input" value={form.funcao} onChange={e => handleFuncaoChange(e.target.value)}>
                    {funcoes.map(f => <option key={f.id} value={f.id}>{f.nome}</option>)}
                  </select>
                </div>
              </div>
              <div className="border-t pt-4">
                <label className="label mb-2">Acessos (opcional customization)</label>
                <div className="grid grid-cols-2 gap-2">
                  {MODULOS.filter(m => !m.adminOnly).map(modulo => (
                    <button key={modulo.key} type="button" onClick={() => !modulo.fixed && toggleAcesso(modulo.key)} className={`p-2 rounded-lg border text-left text-sm ${modulo.fixed ? 'bg-gray-50 border-gray-100 opacity-50' : form.acessos.includes(modulo.key) ? 'border-slate-800 bg-slate-50' : 'border-gray-200'}`} disabled={modulo.fixed}>
                      <div className="flex items-center gap-2">
                        <div className={`w-4 h-4 rounded ${modulo.fixed || form.acessos.includes(modulo.key) ? 'bg-slate-800 text-white' : 'bg-gray-200'}`}>
                          {(modulo.fixed || form.acessos.includes(modulo.key)) && <Check className="w-2.5 h-2.5" />}
                        </div>
                        <span>{modulo.label}</span>
                      </div>
                    </button>
                  ))}
                </div>
              </div>
              <div className="flex gap-2 pt-4">
                <button type="button" onClick={() => setShowModal(false)} className="btn flex-1">Cancelar</button>
                <button type="submit" className="btn btn-primary flex-1">Criar</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal Setores */}
      {showSetorModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-xl p-6 w-full max-w-sm">
            <h2 className="text-lg font-semibold mb-4">Novo Setor</h2>
            <form onSubmit={handleCriarSetor} className="space-y-4">
              <div>
                <label className="label">Nome do Setor</label>
                <input required className="input" value={novoSetorNome} onChange={e => setNovoSetorNome(e.target.value)} placeholder="Ex: Qualidade" />
              </div>
              <div className="flex gap-2">
                <button type="button" onClick={() => setShowSetorModal(false)} className="btn flex-1">Fechar</button>
                <button type="submit" className="btn btn-primary flex-1">Criar</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal Funções */}
      {showFuncaoModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-xl p-6 w-full max-w-md">
            <h2 className="text-lg font-semibold mb-4">{editandoFuncao ? 'Editar Função' : 'Nova Função'}</h2>
            <form onSubmit={handleCriarFuncao} className="space-y-4">
              <div>
                <label className="label">Nome da Função</label>
                <input required className="input" value={novoFuncaoNome} onChange={e => setNovoFuncaoNome(e.target.value)} placeholder="Ex: Coordenador de Obra" />
              </div>
              <div>
                <label className="label mb-2">Acessos</label>
                <div className="grid grid-cols-2 gap-2">
                  {MODULOS.filter(m => !m.adminOnly).map(modulo => (
                    <button key={modulo.key} type="button" onClick={() => !modulo.fixed && toggleNovoFuncaoAcesso(modulo.key)} className={`p-2 rounded-lg border text-sm ${modulo.fixed ? 'bg-gray-50 opacity-50' : novoFuncaoAcessos.includes(modulo.key) ? 'border-slate-800 bg-slate-50' : 'border-gray-200'}`} disabled={modulo.fixed}>
                      <div className="flex items-center gap-2">
                        <div className={`w-4 h-4 rounded ${modulo.fixed || novoFuncaoAcessos.includes(modulo.key) ? 'bg-slate-800 text-white' : 'bg-gray-200'}`}>
                          {(modulo.fixed || novoFuncaoAcessos.includes(modulo.key)) && <Check className="w-2.5 h-2.5" />}
                        </div>
                        <span>{modulo.label}</span>
                      </div>
                    </button>
                  ))}
                </div>
              </div>
              <div className="flex gap-2">
                <button type="button" onClick={() => { setShowFuncaoModal(false); setEditandoFuncao(null) }} className="btn flex-1">Cancelar</button>
                <button type="submit" className="btn btn-primary flex-1">{editandoFuncao ? 'Salvar' : 'Criar'}</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal Editar Perfil */}
      {showEditPerfilModal && selectedUser && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <h2 className="text-lg font-semibold mb-4">Editar Perfil</h2>
            <p className="text-sm text-gray-500 mb-4">{selectedUser.email}</p>
            <div className="space-y-4">
              <div>
                <label className="label">Nome</label>
                <input className="input" value={editPerfilForm.nome} onChange={e => setEditPerfilForm({...editPerfilForm, nome: e.target.value})} />
              </div>
              <div>
                <label className="label">Setor</label>
                <select className="input" value={editPerfilForm.setor} onChange={e => setEditPerfilForm({...editPerfilForm, setor: e.target.value})}>
                  <option value="">Selecionar...</option>
                  {setores.map(s => <option key={s.id} value={s.id}>{s.nome}</option>)}
                </select>
              </div>
              <div>
                <label className="label">Função</label>
                <select className="input" value={editPerfilForm.funcao} onChange={e => setEditPerfilForm({...editPerfilForm, funcao: e.target.value})}>
                  <option value="">Selecionar...</option>
                  {funcoes.map(f => <option key={f.id} value={f.id}>{f.nome}</option>)}
                </select>
              </div>
              
              <div className="border-t pt-4">
                <label className="label mb-2">Acessos (Módulos)</label>
                <div className="grid grid-cols-2 gap-2">
                  {MODULOS.filter(m => !m.adminOnly).map(modulo => (
                    <button key={modulo.key} type="button" onClick={() => !modulo.fixed && toggleEditPerfilAcesso(modulo.key)} className={`p-2 rounded-lg border text-left text-sm ${modulo.fixed ? 'bg-gray-50 border-gray-100 opacity-50' : editPerfilForm.acessos.includes(modulo.key) ? 'border-slate-800 bg-slate-50' : 'border-gray-200'}`} disabled={modulo.fixed}>
                      <div className="flex items-center gap-2">
                        <div className={`w-4 h-4 rounded ${modulo.fixed || editPerfilForm.acessos.includes(modulo.key) ? 'bg-slate-800 text-white' : 'bg-gray-200'}`}>
                          {(modulo.fixed || editPerfilForm.acessos.includes(modulo.key)) && <Check className="w-2.5 h-2.5" />}
                        </div>
                        <span>{modulo.label}</span>
                      </div>
                    </button>
                  ))}
                </div>
                <button 
                  type="button" 
                  onClick={() => toggleEditPerfilAcesso('admin')} 
                  className="mt-2 text-sm text-blue-600 hover:text-blue-800"
                >
                  {MODULOS.filter(m => !m.adminOnly && m.key !== 'ponto' && m.key !== 'acessos' && m.key !== 'alertas').every(m => editPerfilForm.acessos.includes(m.key)) 
                    ? 'Desmarcar Todos' 
                    : 'Marcar Todos (Admin)'}
                </button>
              </div>
              
               <div className="border-t pt-4">
                 <label className="label mb-2">Alertas que recebe</label>
                 <div className="grid grid-cols-2 gap-2">
                   {TIPOS_ALERTAS.map(alerta => (
                     <button key={alerta.key} type="button" onClick={() => toggleEditPerfilAlerta(alerta.key)} className={`p-2 rounded-lg border text-left text-sm ${editPerfilForm.alertas.includes(alerta.key) ? 'border-slate-800 bg-slate-50' : 'border-gray-200'}`}>
                       <div className="flex items-center gap-2">
                         <div className={`w-4 h-4 rounded ${editPerfilForm.alertas.includes(alerta.key) ? 'bg-slate-800 text-white' : 'bg-gray-200'}`}>
                           {editPerfilForm.alertas.includes(alerta.key) && <Check className="w-2.5 h-2.5" />}
                         </div>
                         <span>{alerta.label}</span>
                       </div>
                     </button>
                   ))}
                 </div>
               </div>

               {/* Atestado Médico */}
               <div className="border-t pt-4">
                 <h3 className="font-medium mb-3">Atestado Médico</h3>
                 <div className="space-y-3">
                   <div>
                     <label className="label">Upload do Atestado (PDF)</label>
                     <input 
                       type="file" 
                       accept=".pdf"
                       onChange={async (e) => {
                         const file = e.target.files?.[0]
                         if (!file) return
                         if (file.type !== 'application/pdf') {
                           toast.error('Apenas ficheiros PDF são permitidos')
                           return
                         }
                         if (file.size > 5 * 1024 * 1024) {
                           toast.error('Ficheiro muito grande (máximo 5MB)')
                           return
                         }
                         // Upload para Supabase Storage
                         const supabase = createClient()
                         const path = `atestados/${selectedUser?.id}/${Date.now()}_${file.name}`
                         const { error: uploadError } = await supabase.storage
                           .from('documentos')
                           .upload(path, file)
                         if (uploadError) {
                           toast.error('Erro no upload: ' + uploadError.message)
                           return
                         }
                         const { data: urlData } = supabase.storage
                           .from('documentos')
                           .getPublicUrl(path)
                         // Atualizar perfil
                         setEditPerfilForm({ ...editPerfilForm, atestado_medico_url: urlData.publicUrl })
                         toast.success('Atestado carregado!')
                       }}
                       className="input"
                     />
                     {editPerfilForm.atestado_medico_url && (
                       <div className="mt-2 flex items-center gap-2">
                         <a href={editPerfilForm.atestado_medico_url} target="_blank" className="text-sm text-blue-600 hover:underline">
                           Ver Atestado Atual
                         </a>
                       </div>
                     )}
                   </div>
                   <div>
                     <label className="label">Data de Validade</label>
                     <input 
                       type="date" 
                       className="input"
                       value={editPerfilForm.atestado_medico_validade || ''}
                       onChange={e => setEditPerfilForm({ ...editPerfilForm, atestado_medico_validade: e.target.value })}
                     />
                   </div>
                 </div>
               </div>
                        <span>{alerta.label}</span>
                      </div>
                    </button>
                  ))}
                </div>
              </div>
              
              <div className="flex gap-2 pt-2">
                <button type="button" onClick={() => setShowEditPerfilModal(false)} className="btn flex-1">Cancelar</button>
                <button type="button" onClick={handleSavePerfil} className="btn btn-primary flex-1">Salvar</button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Modal Liberar Acessos */}
      {showAcessosModal && selectedUser && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-xl p-6 w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <h2 className="text-lg font-semibold mb-4">Liberar Acessos</h2>
            <p className="text-sm text-gray-500 mb-2">{selectedUser.nome_completo}</p>
            <p className="text-sm text-gray-400 mb-4">{selectedUser.email}</p>
            <div className="space-y-6">
              <div>
                <label className="label mb-2">Módulos de Acesso</label>
                <div className="grid grid-cols-2 gap-2">
                  {MODULOS.filter(m => !m.adminOnly).map(modulo => (
                    <button key={modulo.key} type="button" onClick={() => !modulo.fixed && toggleEditPerfilAcesso(modulo.key)} className={`p-2 rounded-lg border text-left text-sm ${modulo.fixed ? 'bg-gray-50 border-gray-100 opacity-50' : editPerfilForm.acessos.includes(modulo.key) ? 'border-slate-800 bg-slate-50' : 'border-gray-200'}`} disabled={modulo.fixed}>
                      <div className="flex items-center gap-2">
                        <div className={`w-4 h-4 rounded ${modulo.fixed || editPerfilForm.acessos.includes(modulo.key) ? 'bg-slate-800 text-white' : 'bg-gray-200'}`}>
                          {(modulo.fixed || editPerfilForm.acessos.includes(modulo.key)) && <Check className="w-2.5 h-2.5" />}
                        </div>
                        <span>{modulo.label}</span>
                      </div>
                    </button>
                  ))}
                </div>
                <button 
                  type="button" 
                  onClick={() => toggleEditPerfilAcesso('admin')} 
                  className="mt-2 text-sm text-blue-600 hover:text-blue-800"
                >
                  {MODULOS.filter(m => !m.adminOnly && m.key !== 'ponto' && m.key !== 'acessos' && m.key !== 'alertas').every(m => editPerfilForm.acessos.includes(m.key)) 
                    ? 'Desmarcar Todos' 
                    : 'Marcar Todos (Admin)'}
                </button>
              </div>
              
              <div className="border-t pt-4">
                <label className="label mb-2">Tipos de Alertas</label>
                <div className="grid grid-cols-1 gap-2">
                  {TIPOS_ALERTAS.map(alerta => (
                    <button key={alerta.key} type="button" onClick={() => toggleEditPerfilAlerta(alerta.key)} className={`p-2 rounded-lg border text-left text-sm ${editPerfilForm.alertas.includes(alerta.key) ? 'border-slate-800 bg-slate-50' : 'border-gray-200'}`}>
                      <div className="flex items-center gap-2">
                        <div className={`w-4 h-4 rounded ${editPerfilForm.alertas.includes(alerta.key) ? 'bg-slate-800 text-white' : 'bg-gray-200'}`}>
                          {editPerfilForm.alertas.includes(alerta.key) && <Check className="w-2.5 h-2.5" />}
                        </div>
                        <span>{alerta.label}</span>
                      </div>
                    </button>
                  ))}
                </div>
              </div>
              
              <div className="flex gap-2 pt-2">
                <button type="button" onClick={() => setShowAcessosModal(false)} className="btn flex-1">Cancelar</button>
                <button type="button" onClick={handleSaveAcessos} className="btn btn-primary flex-1">Salvar Acessos</button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Modal Alterar Senha */}
      {showSenhaModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-white rounded-xl p-6 w-full max-w-sm">
            <h2 className="text-lg font-semibold mb-2">Alterar Senha</h2>
            <p className="text-sm text-gray-500 mb-4">{selectedUser?.nome_completo}</p>
            <div className="space-y-4">
              <input type="password" className="input" value={novaSenha} onChange={e => setNovaSenha(e.target.value)} placeholder="Nova senha" minLength={6} />
              <div className="flex gap-2">
                <button onClick={() => setShowSenhaModal(false)} className="btn flex-1">Cancelar</button>
                <button onClick={handleResetSenha} className="btn btn-primary flex-1">Alterar</button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
